{
  "name": "yasir-portfolio-orders",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-21",
  "vars": {
    "ALLOWED_ORIGINS": "https://yasirgrc08-techie.github.io"
  },
  "d1_databases": [
    {
      "binding": "ORDERS_DB",
      "database_name": "yasir-portfolio-orders",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ]
}